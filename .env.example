# ============================================================
# Google Gemini free tier (recommended)
# Free key: https://aistudio.google.com/apikey  (starts with AIza)
# ============================================================
PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.7-flash
# Free-tier flash models get congested (503 "high demand") in waves. If the
# primary is overloaded the run retries, then falls through to these.
GOOGLE_FALLBACKS=gemini-3.5-flash-lite,gemini-3.8-flash
# RETRIES_PER_MODEL=2

# Search backend.
#   duckduckgo = free, no key (works on the free tier)
#   google     = Gemini built-in grounding (NOT in the free tier -> 429)
SEARCH=duckduckgo

# Engines tried in order. Verified working: duckduckgo, bing, auto.
# (brave/mojeek/startpage/google/wikipedia return "No results"; yahoo times out.)
SEARCH_BACKENDS=duckduckgo,bing

# Optional but recommended. Free key at https://tavily.com (~1,000 searches/mo).
# When set, Tavily is tried first and the engines above become the fallback.
# TAVILY_API_KEY=tvly-...

# ============================================================
# Local Ollama (free fallback, no key, fully offline)
# ============================================================
# PROVIDER=ollama
# OLLAMA_MODEL=gemma4:26b
# OLLAMA_MODEL=gemma4:latest

# ============================================================
# opencode Console (PAID — needs account credits)
# The free tier is app-only and returns 403 to external scripts.
# ============================================================
# PROVIDER=opencode
# OPENCODE_API_KEY=
# OPENCODE_MODEL=deepseek-v4.1-flash
